# GAP (L1) build inputs — upstream corpora, gitignored per 01_gap_schema.md
# Decision 4. The distilled per-flow extracts + aggregate under data/gap/ ARE
# committed; only these raw upstream inputs are ignored.
data/gap/_*

# GASP (L2) visualisation outputs — diagnostic-quality artefacts, regenerable
# via data/gasp/_viz/gasp_viz.py. Mirrors the data/gap/_* pattern.
data/gasp/_*

# OGASP (L3) regenerable outputs — petri/_viz/ diagrams via
# `python -m mtdsim.l3_simulation.petri`; timeline/_timelines/ library +
# timeline/_viz/ figures via `python -m mtdsim.l3_simulation.timeline`. The
# summary JSONs, reports and READMEs under data/ogasp/ ARE committed; only
# the underscore-prefixed dirs are ignored. Same pattern as data/gasp/_*.
data/ogasp/petri/_*
data/ogasp/timeline/_*

# macOS Finder metadata
.DS_Store
# LaTeX build artefacts under docs/thesis/ (the nested docs/thesis/.gitignore
# cannot be versioned -- the `.gitignore` pattern above ignores nested
# .gitignore files -- so the rules live here instead)
docs/thesis/*.aux
docs/thesis/*.bbl
docs/thesis/*.blg
docs/thesis/*.log
docs/thesis/*.out
docs/thesis/*.toc
docs/thesis/*.lof
docs/thesis/*.lot
docs/thesis/*.fls
docs/thesis/*.fdb_latexmk
docs/thesis/*.synctex.gz
docs/thesis/*.dvi
docs/thesis/*.ps
