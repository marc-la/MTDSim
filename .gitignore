# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store

# Local working material, never committed: writing notes, source papers, session context
_workspace/
CLAUDE.md
.claude/
docs/sources/

# Fetched input (python -m mtdsim.l0_cti, SHA-256 checked). The Attack Flow
# snapshot in data/gap/_corpus_stix/ IS committed: the upstream export drifts.
data/gap/_attack/
# Regenerable diagnostic views
data/gap/_viz/
data/gasp/_*
data/ogasp/petri/_*
data/ogasp/timeline/_*
data/ogasp/**/*_sweep.json
data/misc/_viz/*
!data/misc/_viz/plurality/
!data/misc/_viz/predictability/
data/misc/_viz/*/*.png
data/misc/_viz/*/*.json
data/misc/_viz/*/*.jsonl

# Raw experiment runs: too large for git (75 GB), archived with checksums (README).
# Each experiment's scripts and its numbers*.json summaries ARE committed.
experiments/**/*.jsonl
experiments/**/*.pkl
experiments/**/*.pgid
experiments/**/*.pre_ratio_fix
experiments/**/*.ratio_fix_tmp
experiments/**/per_run.csv

# Simulator default outputs
experimental_data/
output/

# LaTeX build products
docs/thesis/**/*.aux
docs/thesis/**/*.bbl
docs/thesis/**/*.blg
docs/thesis/**/*.log
docs/thesis/**/*.out
docs/thesis/**/*.toc
docs/thesis/**/*.lof
docs/thesis/**/*.lot
docs/thesis/**/*.low
docs/thesis/**/*.nav
docs/thesis/**/*.snm
docs/thesis/**/*.fls
docs/thesis/**/*.fdb_latexmk
docs/thesis/**/*.synctex.gz
